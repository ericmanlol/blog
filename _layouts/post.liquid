<!DOCTYPE html>
<html lang="en">
{% include "head.liquid" %}
<body>
  {% include "header.liquid" %}

  <main class="content-section">
    <article class="content-inner">
      <header class="post-header">
        <h1>{{ page.title }}</h1>
        {% if page.published_date %}
        <time class="post-date" datetime="{{ page.published_date | date: "%Y-%m-%d" }}">{{ page.published_date | date: "%B %d, %Y" }}</time>
        {% endif %}

        {%- comment -%}
          .size, not truthiness — an empty array is truthy in Liquid.
          slugify matches Cobalt's own tag directory naming.
        {%- endcomment -%}
        {% if page.tags.size > 0 %}
        <ul class="tag-list">
          {%- for tag in page.tags %}
          <li><a class="tag" href="/tags/{{ tag | slugify }}/">{{ tag }}</a></li>
          {%- endfor %}
        </ul>
        {% endif %}
      </header>

      {{ page.content }}

      <footer class="post-footer">
        <a href="/">&#8592; All posts</a>
      </footer>
    </article>
  </main>

  {% include "footer.liquid" %}
</body>
</html>
